# Normalize all text files to LF line endings regardless of OS.
* text=auto eol=lf

# Explicit text types (force LF even if autodetection misfires)
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.sh text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary files must never be modified by line-ending normalization
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.pptx binary
*.xlsx binary
*.zip binary
