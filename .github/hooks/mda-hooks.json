      {
        "type": "command",
        "bash": "python3 .github/hooks/scripts/mda_hook.py sessionStart",
        "powershell": "python .github/hooks/scripts/mda_hook.py sessionStart",
        "cwd": ".",
        "timeoutSec": 15
      }
    ],
